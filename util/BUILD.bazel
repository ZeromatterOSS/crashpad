# net is split into a separate target from util so that client code does
# not have to depend on it.
#
# libcurl is dlopen()ed at runtime, so only curl headers are needed at compile time.
crashpad_cc_library(
    name = "net",
    srcs = [
        "net/http_body.cc",
        "net/http_body_gzip.cc",
        "net/http_multipart_builder.cc",
        "net/http_transport.cc",
        "net/url.cc",
        "net/http_transport_libcurl.cc",
    ],
    hdrs = [
        "net/http_body.h",
        "net/http_body_gzip.h",
        "net/http_headers.h",
        "net/http_multipart_builder.h",
        "net/http_transport.h",
        "net/url.h",
    ],
    deps = [
        ":util",
        "//:package",
        "//third_party/curl:curl_headers",
        "//third_party/mini_chromium/mini_chromium/base",
    ],
)
