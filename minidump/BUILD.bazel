load("//bazel:crashpad.bzl", "crashpad_cc_library")

package(default_visibility = ["//visibility:public"])

# :format is the only part of minidump that snapshot may depend on.
crashpad_cc_library(
    name = "format",
    srcs = ["minidump_extensions.cc"],
    hdrs = [
        "minidump_context.h",
        "minidump_extensions.h",
    ],
    deps = [
        "//compat",
        "//snapshot:context",
        "//third_party/mini_chromium/mini_chromium/base",
        "//util",
    ],
)

